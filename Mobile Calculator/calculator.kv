<CalculatorLayout>:
    orientation: "vertical"
    padding: 15
    spacing: 10

    canvas.before:
        Color:
            rgb: 0.88, 0.88, 0.88
        Rectangle:
            pos: self.pos
            size: self.size

    # Display input box
    TextInput:
        id: input_box
        text: ""
        font_size: 40
        size_hint_y: 0.2
        halign: "right"
        valign: "middle"
        multiline: False
        foreground_color: 0,0,0,1
        background_color: 0.95,0.95,0.95,1
        padding: [10, 10]

    # History Tab
    BoxLayout:
        orientation: "vertical"
        size_hint_y: 0.25

        BoxLayout:
            size_hint_y: 0.2
            spacing: 5
            Button:
                text: "Show History"
                on_press: history_scroll.height = "150dp" if history_scroll.height == 0 else 0
                background_color: 0.3,0.6,0.9,1
                color: 1,1,1,1
            Button:
                text: "Delete History"
                on_press: root.delete_history()
                background_color: 1,0.3,0.3,1
                color: 1,1,1,1

        ScrollView:
            id: history_scroll
            size_hint_y: None
            height: 0  # collapsed by default
            do_scroll_x: False
            Label:
                id: history_box
                text: ""
                font_size: 18
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width-10, None
                valign: "top"
                color: 0.3,0.3,0.3,1

    # Buttons grid
    GridLayout:
        cols: 4
        spacing: 10
        size_hint_y: 0.55
        row_force_default: True
        row_default_height: self.height / 5

        # Row 1
        Button:
            text: "C"
            on_press: root.clear()
            background_color: 1,0.4,0,1
            color: 1,1,1,1
            font_size: 24
        Button:
            text: "⌫"
            on_press: root.backspace()
            background_color: 0.7,0.7,0.7,1
            color: 0,0,0,1
            font_size: 24
        Button:
            text: "%"
            on_press: root.button_press("%")
            background_color: 0.7,0.7,0.7,1
            color: 0,0,0,1
            font_size: 24
        Button:
            text: "/"
            on_press: root.button_press("/")
            background_color: 0.9,0.6,0.2,1
            color: 1,1,1,1
            font_size: 24

        # Row 2
        Button:
            text: "7"
            on_press: root.button_press("7")
            background_color: 0.9,0.9,0.9,1
            color: 0,0,0,1
            font_size: 24
        Button:
            text: "8"
            on_press: root.button_press("8")
            background_color: 0.9,0.9,0.9,1
            color: 0,0,0,1
            font_size: 24
        Button:
            text: "9"
            on_press: root.button_press("9")
            background_color: 0.9,0.9,0.9,1
            color: 0,0,0,1
            font_size: 24
        Button:
            text: "*"
            on_press: root.button_press("*")
            background_color: 0.9,0.6,0.2,1
            color: 1,1,1,1
            font_size: 24

        # Row 3
        Button:
            text: "4"
            on_press: root.button_press("4")
            background_color: 0.9,0.9,0.9,1
            color: 0,0,0,1
            font_size: 24
        Button:
            text: "5"
            on_press: root.button_press("5")
            background_color: 0.9,0.9,0.9,1
            color: 0,0,0,1
            font_size: 24
        Button:
            text: "6"
            on_press: root.button_press("6")
            background_color: 0.9,0.9,0.9,1
            color: 0,0,0,1
            font_size: 24
        Button:
            text: "-"
            on_press: root.button_press("-")
            background_color: 0.9,0.6,0.2,1
            color: 1,1,1,1
            font_size: 24

        # Row 4
        Button:
            text: "1"
            on_press: root.button_press("1")
            background_color: 0.9,0.9,0.9,1
            color: 0,0,0,1
            font_size: 24
        Button:
            text: "2"
            on_press: root.button_press("2")
            background_color: 0.9,0.9,0.9,1
            color: 0,0,0,1
            font_size: 24
        Button:
            text: "3"
            on_press: root.button_press("3")
            background_color: 0.9,0.9,0.9,1
            color: 0,0,0,1
            font_size: 24
        Button:
            text: "+"
            on_press: root.button_press("+")
            background_color: 0.9,0.6,0.2,1
            color: 1,1,1,1
            font_size: 24

        # Row 5
        Button:
            text: "0"
            on_press: root.button_press("0")
            background_color: 0.9,0.9,0.9,1
            color: 0,0,0,1
            font_size: 24
        Button:
            text: "."
            on_press: root.button_press(".")
            background_color: 0.9,0.9,0.9,1
            color: 0,0,0,1
            font_size: 24
        Button:
            text: "="
            on_press: root.calculate()
            background_color: 0.3,0.8,0.3,1
            color: 1,1,1,1
            font_size: 24
        Widget:
